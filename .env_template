SECRET_KEY=your_secret_key
DEBUG=True

DB_NAME=mailing_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CACHE_ENABLED=False
REDIS_URL=redis://127.0.0.1:6379/1

